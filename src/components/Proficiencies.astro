---
import { PROFICIENCIES } from "../data/sheet";
---
<section class="box profs" id="armory" aria-labelledby="h-armory">
  <h2 id="h-armory" tabindex="-1">Armory · Proficiencies</h2>
  <ul>
    {
      PROFICIENCIES.map(([name, level]) => (
        <li>
          <span class="dot on" aria-hidden="true" />
          <span class={`dot${level > 1 ? " on" : ""}`} aria-hidden="true" />
          {name}
          <span class="visually-hidden">{level > 1 ? " (expertise)" : " (proficient)"}</span>
        </li>
      ))
    }
  </ul>
  <p class="legend" aria-hidden="true">
    <span class="dot on"></span><span class="dot on"></span> expertise &nbsp;
    <span class="dot on"></span><span class="dot"></span> proficient
  </p>
</section>

<style is:global>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
